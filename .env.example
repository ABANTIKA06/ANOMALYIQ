# ─── Screener.in credentials ─────────────────────────────────────────────────
SCREENER_EMAIL=your@email.com
SCREENER_PASSWORD=yourpassword

# ─── Download settings ────────────────────────────────────────────────────────
# Folder where Excel files will be saved (relative or absolute)
DOWNLOAD_DIR=./screener_exports

# Seconds to wait between each company download (be respectful to the server)
DELAY_SECONDS=3

# Data type preference: "consolidated" or "standalone"
DATA_TYPE=consolidated
